# ==========================================================
# PORTAL DKK — Template Environment Variable
# Copy file ini menjadi ".env" lalu isi sesuai lingkungan:
#   Copy-Item .env.example .env   (PowerShell)
#   cp .env.example .env          (Linux / Git Bash)
# File .env TIDAK boleh di-commit (sudah ada di .gitignore).
# ==========================================================

# --- Development lokal (Laragon / XAMPP default) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portal_dkk
DB_USER=root
DB_PASS=

